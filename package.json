{
  "name": "component-tracker",
  "version": "3.0.0",
  "description": "Local-first inventory and component tracking application built with Node.js, Express, Vue 3 and SQLite.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js"
  },
  "keywords": [
    "inventory",
    "components",
    "electronics",
    "sqlite",
    "nodejs",
    "vue",
    "local-first"
  ],
  "author": "mera-system",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@primeuix/themes": "^1.2.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.6",
    "qrcode": "^1.5.4",
    "vite": "^6.3.5",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.10",
    "vue-router": "^4.5.1"
  }
}
