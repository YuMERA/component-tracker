<% 
    // Provera da li je Edit mod.
    const isEdit = locals.component ? true : false; 
    const formTitle = isEdit ? 'Edit Component' : 'Add New Component';
    // Pomoćna funkcija za proveru selektovane kategorije
    // - EDIT: koristi component.category
    // - ADD + error: koristi formData.category
    const isCategorySelected = (catName) => {
        if (isEdit) {
            return component?.category === catName ? "selected" : "";
        }

        return formData?.category === catName ? "selected" : "";
    };
%>

<header class="d-flex justify-content-between align-items-center mb-0">
   
    <div class="d-flex">    
        <h1 class="h3 text-body mb-0"
            data-i18n="<%= isEdit ? 'add.title_edit' : 'add.title_add' %>">
            <%= formTitle %>
        </h1>
        <i class="bi bi-info-circle ms-2 text-muted"
        role="button"
        title="About low Add/Edit"
        data-i18n-attr="title"
        data-i18n="add.help_icon_title"
        onclick="togglePageHelp()"></i>
    </div>
    <!--
    <% if (isEdit) { %>
        <a href="/components/details/<%= component.id %>" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            <span data-i18n="add.back_to_details">Back to Details</span>
        </a>
    <% } %>
    -->
</header>

<p class="card-text text-muted small mb-3"
   data-i18n="add.subtitle">
    Edit an existing item or add a new item to the database.
</p>

<% if (justAdded) { %>
    <div
        class="alert alert-success mt-3"
        id="justAddedAlert"
        data-i18n="add.just_added">
        Component saved. Ready for next entry.
    </div>
<% } %>

<!-- Toggle info kada se klikne na ikonu/button-->
<div id="pageHelp"
    class="card border-0 bg-body-tertiary my-2 d-none">
    <div class="card-body small text-body-secondary">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
            <div>
                <% if (isEdit) { %>
                    <strong class="text-body"
                            data-i18n="add.help_edit_title">
                        About Editing Components
                    </strong><br>
                    <span data-i18n="add.help_edit_p1">
                        Low Stock Alerts highlight components whose quantity has fallen below the defined minimum stock level.
                    </span>
                    <br>
                    <span data-i18n="add.help_edit_p2">
                        This helps you notice parts that may soon run out, so you can restock them before they become unavailable during work.
                    </span>
                    <br>
                    <span data-i18n="add.help_edit_p3">
                        Alerts are informational only — they do not block usage or trigger automatic actions.
                    </span>
                    <br>
                    <span data-i18n="add.help_edit_p4">
                        Minimum stock values are defined per component and can be adjusted at any time.
                    </span>

                <% } else { %>
                    <strong class="text-body"
                            data-i18n="add.help_add_title">
                        About Adding New Components
                    </strong><br>
                    <span data-i18n="add.help_add_p1">
                        This form is used to add new physical components to the workshop inventory.
                    </span>
                    <br>
                    <span data-i18n="add.help_add_p2">
                        Basic details such as category, quantity, and location are entered manually.
                    </span>
                    <br>
                    <span data-i18n="add.help_add_p3">
                        Optional API services can be used to automatically fill in technical data like name, description, datasheet, and image, helping speed up the initial entry process.
                    </span>
                    <br>
                    <span data-i18n="add.help_add_p4">
                        API usage is intended as a convenience feature and does not replace manual verification or editing.
                    </span>

                 <%} %>   
            </div>
        </div>
    </div>
</div>

<% if (locals.message) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <span data-i18n="<%= locals.message %>"><%= locals.message %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if (locals.error) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span data-i18n="<%= locals.error %>"><%= locals.error %></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="card shadow-sm border-0 card-form-bg">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-0">
            <h5 class="card-title mb-4"
                data-i18n="add.section_component_details">
                Component Details
            </h5>
                <span class="text-muted fst-italic small">
                    <i class="bi bi-info-circle-fill opacity-50 me-1"></i>
                    <span id="api_service"></span>
                </span>
        </div>

        <form
            id="addComponentForm"
            action="<%=
                isEdit
                    ? `/components/edit/${component.id}${queryString ? '?' + queryString : ''}`
                    : `/components/new${queryString ? '?' + queryString : ''}`
            %>"
            method="POST"
            data-just-added="<%= locals.justAdded ? '1' : '0' %>">

            <div class="row mb-3">

                <div class="col-md-6">
                    <label for="part_number" class="form-label">
                        <span data-i18n="add.part_number_label">Part Number (Unique)</span>
                        <span class="text-danger">*</span>
                    </label>
                
                    <div class="input-group">
                        <input
                            type="text"
                            class="form-control"
                            id="part_number"
                            name="part_number"
                            data-order="1"
                            value="<%= isEdit ? component.part_number : (formData?.part_number || '') %>"
                            <%= locals.justAdded ? 'autofocus' : '' %>
                            required>
                
                        <% if (activeService) { %>
                            <button
                                class="btn btn-secondary"
                                type="button"
                                id="findPartBtn"
                                title="Find using active API service"
                                data-i18n-attr="title"
                                data-i18n="add.find_part_title">
                                <span data-i18n="add.find_part_btn">Find</span>
                            </button>
                        <% } %>
                    </div>
                </div>

                <div class="col-md-6">
                    <label for="name" class="form-label">
                        <span data-i18n="add.name_label">Component Name</span>
                        <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" id="name" name="name" data-order="2" 
                            value="<%= isEdit ? component.name :(formData?.name || '') %>" required>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label for="quantity" class="form-label"
                           data-i18n="add.quantity_label">
                        Quantity
                    </label>
                    <input type="number" class="form-control" id="quantity" name="quantity" data-order="3" min="0" required
                            value="<%= isEdit ? component.quantity : (formData?.quantity || 0) %>">
                </div>
                <div class="col-md-4">
                    <label for="min_stock" class="form-label"
                           data-i18n="add.min_stock_label">
                        Min. Stock Level
                    </label>
                    <input type="number" class="form-control" id="min_stock" name="min_stock" data-order="4" min="0" required
                            value="<%= isEdit ? component.min_stock : (formData?.min_stock || 0) %>">
                    <div class="form-text"
                         data-i18n="add.min_stock_help">
                        Alert will be triggered below this level.
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="location" class="form-label"
                           data-i18n="add.location_label">
                        Location (e.g. Rack B, Drawer 3)
                    </label>
                    <input type="text" class="form-control" id="location" name="location" data-order="5"
                            value="<%= isEdit ? component.location : (formData?.location || '') %>">
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="category" class="form-label d-block">
                         <span data-i18n="add.category_label">Category</span>
                        <span class="text-danger">*</span>
                    </label> 
                    
                    <div class="input-group">
                        <select class="form-select" id="category" name="category" data-order="6" required>
                            <option value=""
                                data-i18n="add.category_placeholder"
                                <%= (!isEdit && !formData?.category) || (isEdit && !component?.category) ? 'selected' : '' %>>                                
                                -- Select Category (Optional) --
                            </option>
                            
                            <% if (locals.categories && locals.categories.length > 0) { %>
                                <% locals.categories.forEach(cat => { %>
                                    <option value="<%= cat.name %>"
                                            <%= isCategorySelected(cat.name) %>>
                                        <%= cat.name %> 
                                    </option>
                                <% }); %>
                            <% } %>

                            <% if (isEdit && component.category && (!locals.categories || !locals.categories.find(c => c.name === component.category))) { %>
                                <option value="<%= component.category %>" selected>
                                    <%= component.category %> (Old/Undefined)
                                </option>
                            <% } %>

                        </select>

                        <button 
                            type="button"
                            class="btn btn-secondary"
                            id="addCategoryBtn"
                            title="Add new category"
                            data-i18n-attr="title"
                            data-i18n="add.add_category_title">
                            <i class="bi bi-plus-lg"></i>
                        </button>

                    </div>
                </div>
                
                <div class="col-md-6">
                    <label for="datasheet_url" class="form-label"
                           data-i18n="add.datasheet_label">
                        Datasheet URL
                    </label>
                    <input type="url" class="form-control" id="datasheet_url" name="datasheet_url" data-order="7" placeholder="https://..."
                            value="<%= isEdit ? component.datasheet_url : (formData?.datasheet_url || '') %>">
                </div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label"
                       data-i18n="add.description_label">
                    Description / Specifications
                </label>
                <textarea class="form-control" id="description" name="description" data-order="8" rows="5"><%= isEdit ? component.description : ( formData?.description || '') %></textarea>
            </div>

            <div class="mb-3">
                <div class="row">
                    <!-- INPUT POLJE ZA URL (Veće - 9 kolona) -->
                    <div class="col-md-9">
                        <label for="image_url" class="form-label"
                               data-i18n="add.image_url_label">
                            Image URL (Optional)
                        </label>
                        <input 
                            type="url" 
                            class="form-control" 
                            id="image_url" 
                            name="image_url" 
                            data-order="9"
                            placeholder="https://..."
                            value="<%= isEdit ? component.image_url : (formData?.image_url || '') %>"
                        >
                    </div>
                    <!-- PROSTOR ZA PREGLED SLIKE (Manji - 3 kolone) -->
                    <div class="col-md-3 d-flex align-items-end">
                        <label class="form-label invisible d-none d-md-block"
                                data-i18n="add.preview_label">
                            Preview
                        </label>
                        <div class="d-flex align-items-center justify-content-center p-2 border rounded w-100" style="height: 65px; background-color: var(--bs-light-bg-subtle);">
                            <!-- DODATOK: border i border-secondary-subtle za suptilni okvir oko slike -->
                            <img 
                                id="image_preview" 
                                src="<%= isEdit && component.image_url ? component.image_url : (formData?.image_url || '') %>" 
                                alt="Image Preview" 
                                class="border rounded border-secondary-subtle"
                                style="max-height: 100%; max-width: 100%; object-fit: contain; display: none;"
                                onerror="this.style.display='none';" 
                            >
                            <span id="preview_placeholder"
                                  data-i18n="add.no_image">
                                No Image
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex justify-content-end">
                <a href="<%= queryString ? `/components?${queryString}` : '/components' %>"
                   class="btn btn-outline-secondary me-2"
                   data-i18n="add.cancel_btn">
                    Cancel
                </a>
            
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-2"></i>
                    <span data-i18n="<%= isEdit ? 'add.save_changes' : 'add.save_component' %>">
                        <%= isEdit ? 'Save Changes' : 'Save Component' %>
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal za upravljanje kategorijama (bez kompleksne JS logike) -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-top">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"
                    data-i18n="add.modal_add_category_title">
                    Add New Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input
                    type="text"
                    class="form-control"
                    id="newCategoryName"
                    placeholder="Category name"
                    data-i18n-attr="placeholder"
                    data-i18n="add.category_name_placeholder">
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal"
                        data-i18n="add.cancel_btn">
                    Cancel
                </button>
                <button class="btn btn-primary" id="saveCategoryBtn"
                        data-i18n="add.save_btn">
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // *********************************************************************
    // JAVASCRIPT ZA PREGLED SLIKE (IMAGE PREVIEW) i MODAL OSVEŽAVANJE
    // *********************************************************************

    document.addEventListener('DOMContentLoaded', () => {
        const imageUrlInput = document.getElementById('image_url');
        const imagePreview = document.getElementById('image_preview');
        const previewPlaceholder = document.getElementById('preview_placeholder');
        
        // Ispravka sintaksne greške za VSC: koristimo JSON.parse za konverziju EJS stringa u boolean.
        const isEditMode = JSON.parse('<%= isEdit ? "true" : "false" %>');

        const updateImagePreview = () => {
            const url = imageUrlInput.value.trim();

            // Reset stanja
            imagePreview.onload = null;
            imagePreview.onerror = null;

            if (!url) {
                imagePreview.src = '';
                imagePreview.style.display = 'none';
                previewPlaceholder.style.display = 'block';
                return;
            }

            // Postavljamo handlere PRE src
            imagePreview.onload = () => {
                imagePreview.style.display = 'block';
                previewPlaceholder.style.display = 'none';
            };

            imagePreview.onerror = () => {
                imagePreview.style.display = 'none';
                previewPlaceholder.style.display = 'block';
            };

            // Tek sada postavljamo src
            imagePreview.src = url;
        };

        // Inicijalizacija: Postavljanje početnog stanja pri učitavanju stranice
        if (isEditMode && imageUrlInput.value.trim()) {
            updateImagePreview();
        } else {
            imagePreview.style.display = 'none';
            previewPlaceholder.style.display = 'block';
        }

        // Osluškivanje unosa u polje Image URL
        imageUrlInput.addEventListener('input', updateImagePreview);

        //**********************
        // MODAL
        //**********************

        // ********************************************************************
        // Refresh select
        //*********************************************************************
        async function reloadCategorySelect(selectedValue = '') {
            const select = document.getElementById('category');
            if (!select) return;

            try {
                const response = await fetch('/api/categories');
                const categories = await response.json();

                // zapamti trenutno izabrano (ako postoji)
                const currentValue = selectedValue || select.value;

                // očisti sve osim prve opcije
                select.querySelectorAll('option:not(:first-child)').forEach(o => o.remove());

                // dodaj nove opcije
                categories.forEach(cat => {
                    const option = document.createElement('option');
                    option.value = cat.name;
                    option.textContent = cat.name;

                    if (cat.name === currentValue) {
                        option.selected = true;
                    }

                    select.appendChild(option);
                });

            } catch (err) {
                console.error(I18N.t('add.error_reload_categories'), err);
            }
        }

        const addCategoryBtn = document.getElementById('addCategoryBtn');
        const addCategoryModal = new bootstrap.Modal(
            document.getElementById('addCategoryModal')
        );

        addCategoryBtn.addEventListener('click', () => {
            document.getElementById('newCategoryName').value = '';
            addCategoryModal.show();
        });

        document.getElementById('saveCategoryBtn').addEventListener('click', async () => {
            const input = document.getElementById('newCategoryName');
            const name = input.value.trim();
            if (!name) return;

            try {
                const res = await fetch('/admin/categories/add-json', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });

                if (!res.ok) throw new Error();

                addCategoryModal.hide();
                await reloadCategorySelect(name); // selektuj novu

            } catch {
                alert(I18N.t('add.error_add_category'));
            }
        });
       
        //******************************************
        // Poziv API-ja
        //******************************************
        function clearApiFilledFields() {
            document.getElementById('name').value = '';
            document.getElementById('description').value = '';
            document.getElementById('datasheet_url').value = '';
            document.getElementById('image_url').value = '';
            document.getElementById('api_service').textContent = '';

            // reset image preview
            const imagePreview = document.getElementById('image_preview');
            const previewPlaceholder = document.getElementById('preview_placeholder');

            if (imagePreview && previewPlaceholder) {
                imagePreview.src = '';
                imagePreview.style.display = 'none';
                previewPlaceholder.style.display = 'block';
            }

            // 🔹 reset category select na default
            const categorySelect = document.getElementById('category');
            if (categorySelect) {
                categorySelect.selectedIndex = 0; // prva (default) opcija
            }
        }


        const findBtn = document.getElementById('findPartBtn');
        const partInput = document.getElementById('part_number');

        if (findBtn) {
            findBtn.addEventListener('click', async () => {
                const partNumber = partInput.value.trim();
                if (!partNumber) {
                    alert(I18N.t('add.error_part_required'));
                    return;
                }

                try {
                    const response = await fetch(`/tools/api/find-part?part_number=${encodeURIComponent(partNumber)}`);
                    if (!response.ok) throw new Error();

                    const data = await response.json();

                    // Popuni polja u formi ako API vrati podatke
                    if (data.success) {
                        if (data.component_name) document.getElementById('name').value = data.component_name;
                        if (data.part_number) partInput.value = data.part_number;
                        if (data.description) document.getElementById('description').value = data.description;
                        if (data.datasheet_url) document.getElementById('datasheet_url').value = data.datasheet_url;
                        if (data.image_url) {
                            const imageInput = document.getElementById('image_url');
                            imageInput.value = data.image_url;
                            updateImagePreview();
                        }
                        if (data.api_service) {
                            document.getElementById('api_service').textContent = data.api_service || '';
                        }

                    } else {
                        clearApiFilledFields();
                        alert(data.message || I18N.t('add.error_part_not_found'));  
                    }

                } catch (err) {
                    console.error(err);
                    alert(I18N.t('add.error_api'));
                }
            });
        }

        //******************************
        //  Enter navigacija
        //******************************
        const fields = Array.from(
            document.querySelectorAll('[data-order]')
        ).sort((a, b) => {
            return a.dataset.order - b.dataset.order;
        });

        fields.forEach((field, index) => {
            field.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    
                     // DOZVOLI Enter u textarea
                    if (e.target.tagName === 'TEXTAREA') {
                        return;
                    }
                    e.preventDefault();

                    // Ako nije poslednje polje → idi na sledeće
                    if (index < fields.length - 1) {
                        const next = fields[index + 1];
                        next.focus();
                        if (next.select) next.select();
                    } else {
                        // Poslednje polje → submit
                        field.form.submit();
                    }
                }
            });

            // Kada dobije fokus → selektuj tekst
            field.addEventListener('focus', () => {
                if (field.select) field.select();
            });
        });

        const autoFocused = document.querySelector('[autofocus]');

        if (!autoFocused && fields[0]) {
            fields[0].focus();
            fields[0].select();
        }
    });

    //**********************************************************************************
    //** Akcija na promenu jezika za svaku stranu isto
    //**********************************************************************************   
    function applyAddNewI18n() {
        I18N.apply(['layout','add']);
        // 👇 VRATI FOKUS NAKON i18n
        
        const IS_EDIT_MODE = JSON.parse('<%= isEdit ? true : false %>');
        // U EDIT modu NE diramo fokus
        if (IS_EDIT_MODE) {
            return;
        }
        const partNo = document.getElementById('part_number');
        setTimeout(() => {
            if (partNo && document.activeElement !== partNo) {
                partNo.focus();
                partNo.select();
            }
        } , 100);
    }   
    document.addEventListener('DOMContentLoaded', applyAddNewI18n);
    window.addEventListener('languageChanged', applyAddNewI18n);
    //************************************************************************************

    function togglePageHelp() {
        document
            .getElementById('pageHelp')
            .classList.toggle('d-none');
    }

</script>
<script src="/js/confirm-modal.js"></script>   
