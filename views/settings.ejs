<header class="d-flex justify-content-between align-items-center mb-0">
    <div class="d-flex">    
        <h1 class="h3 text-body mb-0" data-i18n="settings.title">Settings</h1>
        <i class="bi bi-info-circle ms-2 text-muted"
        role="button"
        title="About Settings"
        data-i18n-attr="title"
        data-i18n="settings.title_about"
        onclick="togglePageHelp()">
        </i>

    </div>
</header>

<p class="card-text text-muted small mb-2" data-i18n="settings.description1">Manage your inventory preferences.</p>

<!-- Toggle info kada se klikne na ikonu/button-->
<div id="pageHelp"
    class="card border-0 bg-body-tertiary my-2 d-none">
    <div class="card-body small text-body-secondary">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
            <div>
                <strong class="text-body" data-i18n="settings.help_title">About Settings</strong><br>
                <span data-i18n="settings.help_line_1">Settings control general application behavior and preferences.</span><br>
                <span data-i18n="settings.help_line_2">Changes made here affect how the inventory is displayed and managed.</span><br>
                <span data-i18n="settings.help_line_3">Only adjust these options if you understand their effect on your workflow.</span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0">
            <!-- Koristimo generičku Bootstrap klasu za prilagođavanje teme -->
            <div class="card-header bg-body-tertiary fw-bold" data-i18n="settings.description">Appearance</div>
            <div class="card-body pt-2 pb-2">
                <span class="card-text text-muted" data-i18n="settings.appearance_desc">Customize how the application looks</span>

                <div class="list-group list-group-flush" id="theme-options">
                    <!-- Sadržaj dugmadi je vraćen -->
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center" data-theme="light">
                        <i class="bi bi-brightness-high me-2"></i>
                        <div>
                            <div class="fw-bold" data-i18n="settings.theme.light">Light</div>
                            <spanp class="text-muted" data-i18n="settings.theme_light">Bright and clear interface</spanp>
                        </div>
                        <i class="bi bi-check-lg ms-auto theme-check-icon"></i>
                    </button>
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center" data-theme="dark">
                        <i class="bi bi-moon-fill me-2"></i>
                        <div>
                            <div class="fw-bold" data-i18n="settings.theme.dark">Dark</div>
                            <span class="text-muted" data-i18n="settings.theme_dark">Easy on the eyes in low light</span>
                        </div>
                        <i class="bi bi-check-lg ms-auto theme-check-icon"></i>
                    </button>
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center" data-theme="system">
                        <i class="bi bi-display me-2"></i>
                        <div>
                            <div class="fw-bold" data-i18n="settings.theme.system">System</div>
                            <span class="text-muted" data-i18n="settings.theme_system">Follow your device settings</>
                        </div>
                        <i class="bi bi-check-lg ms-auto theme-check-icon"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-body-tertiary fw-bold" data-i18n="settings.language">Language</div>
            <div class="card-body pt-2 pb-2"> 
                <span class="card-text text-muted" data-i18n="settings.language_desc">Select application language</span> 
                <div class="list-group list-group-flush" id="language-options">
                    
                    <a href="#" data-lang="sr" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center fw-bold <%= currentLanguage === 'Sr' ? 'active' : '' %>">
                        Serbian (Sr) 
                        <i class="bi bi-check-lg <%= currentLanguage === 'Sr' ? 'd-block' : 'd-none' %>"></i>
                    </a>
                    
                    <a href="#" data-lang="en" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center fw-bold <%= currentLanguage === 'En' ? 'active' : '' %>">
                        English (En)
                        <i class="bi bi-check-lg <%= currentLanguage === 'En' ? 'd-block' : 'd-none' %>"></i>
                    </a>
    
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', () => {
    
        /* ==============================
           THEME (NE DIRAM – RADI OK)
        ============================== */
    
        const themeOptions = document.getElementById('theme-options');
        const themeButtons = themeOptions.querySelectorAll('button[data-theme]');
    
        function updateThemeUI(activeTheme) {
            themeButtons.forEach(btn => {
                const isSelected = btn.dataset.theme === activeTheme;
                btn.classList.toggle('active', isSelected);
    
                const checkIcon = btn.querySelector('.theme-check-icon');
                if (checkIcon) {
                    checkIcon.classList.toggle('d-none', !isSelected);
                }
            });
        }
    
        function updateThemeStateAndUI(newTheme) {
            localStorage.setItem('theme', newTheme);
            updateThemeUI(newTheme);
    
            const isDark =
                newTheme === 'dark' ||
                (newTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    
            document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
    
            window.dispatchEvent(
                new CustomEvent('themeChanged', { detail: { theme: newTheme } })
            );
        }
    
        updateThemeUI(localStorage.getItem('theme') || 'system');
    
        themeOptions.addEventListener('click', (e) => {
            const btn = e.target.closest('button[data-theme]');
            if (!btn) return;
            updateThemeStateAndUI(btn.dataset.theme);
        });
    
        window.addEventListener('themeChanged', () => {
            updateThemeUI(localStorage.getItem('theme') || 'system');
        });
    
        /* ==============================
           LANGUAGE – OVO JE BITNO
        ============================== */
    
        const languageOptions = document.getElementById('language-options');
    
        function updateLanguageUI() {
            const currentLang = localStorage.getItem('language') || 'en';
    
            document.querySelectorAll('#language-options [data-lang]').forEach(el => {
                const isActive = el.dataset.lang === currentLang;
    
                el.classList.toggle('active', isActive);
    
                const icon = el.querySelector('.bi-check-lg');
                if (icon) {
                    icon.classList.toggle('d-none', !isActive);
                    icon.classList.toggle('d-block', isActive);
                }
            });
        }
    
        // INIT – KADA SE STRANA UČITA
        updateLanguageUI();
    
        // KLIK U SETTINGS-U
        if (languageOptions) {
            languageOptions.addEventListener('click', (e) => {
                const item = e.target.closest('[data-lang]');
                if (!item) return;
    
                e.preventDefault();
                setLanguage(item.dataset.lang); // JEDINO MENJA JEZIK
            });
        }
    
        // PROMENA JEZIKA BILO GDE (NAVBAR / SETTINGS / API)
        window.addEventListener('languageChanged', updateLanguageUI);
    });
    
    
    /* ==============================
       I18N APPLY (OSTAJE)
    ============================== */
    
    function applySettingsI18n() {
        I18N.apply(['layout','settings']);
    }
    
    document.addEventListener('DOMContentLoaded', applySettingsI18n);
    window.addEventListener('languageChanged', applySettingsI18n);
    
    function togglePageHelp() {
        document.getElementById('pageHelp').classList.toggle('d-none');
    }
    </script>
    