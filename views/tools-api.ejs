                if (t) t.dispose();
                new bootstrap.Tooltip(el);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', applyApiI18n);
    window.addEventListener('languageChanged', applyApiI18n);*/

    //**********************************************************************************
    //** Akcija na promenu jezika za svaku stranu isto
        /*  layout se prevede pri load-u
            layout se prevede i kad klikneš SR / EN
            nema bljeska
            nema potrebe da stranice brinu o layoutu
        */
    //***********************************************************************************
    function applyApiI18n() {
        I18N.apply(['layout','api']);
    }

    document.addEventListener('DOMContentLoaded', applyApiI18n);
    // layout mora da reaguje i na live promenu jezika
    window.addEventListener('languageChanged', applyApiI18n);
    //************************************************************************************

    window.confirmDelete = function () {
        return confirm(I18N.t('api.confirm_delete'));
    };

</script>
<script src="/js/confirm-modal.js"></script>    
  
