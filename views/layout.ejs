<!DOCTYPE html>
<html lang="en" data-bs-theme="light" class="i18n-loading">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= pageTitle %></title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="/css/custom-styles.css">
        <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
        
        <style>
            /* AŽURIRANI STILOVI: Ciljamo <html> element za sidebar collapsed stanje */
            
            :root[data-bs-theme="light"] body {
                background-color: #f8f8f8 !important;
            }
            :root[data-bs-theme="dark"] body {
                background-color: #212529 !important;
            }
            
            :root[data-bs-theme="dark"] .border-bottom {
                border-color: #495057 !important;
            }
            .d-flex.flex-column.flex-lg-row.h-100.min-vh-100 {
                min-height: 100vh;
            }
            
            /* Main Content */
            main.flex-grow-1.p-4.overflow-auto {
                min-height: 100%;
                /* Početna desktop margina */
                margin-left: 280px;
                transition: margin-left 0.3s ease;
            }
            /* Desktop Sidebar stil (d-lg-flex) */
            .desktop-sidebar {
                width: 280px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1050;
                transition: width 0.3s ease;
                overflow-x: hidden;
            }
            /* --- STILOVI ZA SKUPŠTENI (COLLAPSED) SIDEBAR --- */
            /* CILJAMO <html> ELEMENT! */
            html.sidebar-collapsed .desktop-sidebar {
                width: 70px;
            }
            
            html.sidebar-collapsed main.flex-grow-1.p-4.overflow-auto {
                margin-left: 70px;
            }
            
            /* Sakrij tekst unutar sidebara kada je skupljen - display: none ZA INSTANT SKLANJANJE */
            html.sidebar-collapsed .sidebar-text {
                display: none !important;
                transition: none;
            }
            /* Osiguraj da ikone ostanu vidljive i centrirane */
            html.sidebar-collapsed .desktop-sidebar .nav-link {
                padding-left: 0.8rem;
                padding-right: 0.8rem;
                display: flex;
                justify-content: center;
            }
            
            /* Osiguraj da se ikone u navigaciji ne skupljaju */
            html.sidebar-collapsed .desktop-sidebar .nav-link i {
                margin-right: 0 !important;
            }
            
            /* Posebno podešavanje za About/Logo sekciju */
            html.sidebar-collapsed .desktop-sidebar .sidebar-logo-details .text-muted,
            html.sidebar-collapsed .desktop-sidebar .sidebar-logo-details .h5 {
                display: none !important;
            }
            
            /* Novo: Sakrij sve unutar FOOTERA kad je skupljen, osim malog paddinga */
            html.sidebar-collapsed .desktop-sidebar .sidebar-footer {
                padding: 0 !important;
                border: none !important;
                height: 40px; /* Mali prostor za padding-bottom od nav */
            }

            .modal-dialog-top {
                align-items: flex-start;
            }
            
            /* Prilagođavanje za mobilne uređaje (manje od lg breakpointa) */
            @media (max-width: 991.98px) {
                main.flex-grow-1.p-4.overflow-auto {
                    margin-left: 0;
                    padding-top: 60px !important;
                }
            }
            
            /* Dodatni stil za desktop logo da bi bio centriran u skupljenom stanju */
            html.sidebar-collapsed .desktop-sidebar .sidebar-logo-details .logo-icon-wrapper {
                /* Uklanja default margin-right za skupljeno stanje */
                margin-right: 0 !important;
            }
            
            html.sidebar-collapsed .desktop-sidebar .sidebar-logo-details {
                /* Osigurava da je kontejner za logo centriran unutar 70px */
                justify-content: center !important;
            }
            
            .i18n-loading body {
                visibility: hidden;
            }

            /* Kontrolna dugmad će se sakriti automatski jer imaju klasu .sidebar-text */
        </style>
        <!-- KRITIČNI SCRIPT ZA TEMU I SIDEBAR - IZVRŠAVA SE ODMAH PRE RENDERINGA BODY-JA -->
        <script>
            // --- INICIJALNO POSTAVLJANJE STANJA SIDEBARA (FOUC prevencija) ---
            const htmlEl = document.documentElement;
            
            const savedCollapsedState = localStorage.getItem('sidebarCollapsed');
            if (savedCollapsedState === 'true') {
                // Dodaj klasu na <html> tag za najbržu primenu CSS-a
                htmlEl.classList.add('sidebar-collapsed');
            }
            
            // --- INICIJALNO POSTAVLJANJE TEME (FOUC prevencija) ---
            const savedTheme = localStorage.getItem('theme') || 'system';
            
            let initialTheme = savedTheme;
            if (savedTheme === 'system' || !savedTheme) {
                const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                initialTheme = systemPrefersDark ? 'dark' : 'light';
            }
            htmlEl.setAttribute('data-bs-theme', initialTheme);
            // --- FUNKCIJE MORAJU BITI DEFINISANE RANO ---
            
            function toggleSidebar() {
                const isCollapsed = htmlEl.classList.toggle('sidebar-collapsed');
                localStorage.setItem('sidebarCollapsed', isCollapsed ? 'true' : 'false');
                
                const toggleIcon = document.getElementById('sidebarToggleIcon');
                if (toggleIcon) {
                    // AŽURIRANE IKONE: Layout Sidebar Inset
                    toggleIcon.classList.toggle('bi-layout-sidebar-inset', !isCollapsed);
                    toggleIcon.classList.toggle('bi-layout-sidebar-inset-reverse', isCollapsed);
                }
            }
            window.toggleSidebar = toggleSidebar;
            
            // Funkcija za primenu teme - Ažurira DOM i ikone na osnovu LocalStorage vrednosti
            function applyLocalStorageTheme(theme) {
                let finalTheme = theme;
                
                if (theme === 'system' || !theme) {
                    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    finalTheme = systemPrefersDark ? 'dark' : 'light';
                }
                htmlEl.setAttribute('data-bs-theme', finalTheme);
                
                // Ažuriranje ikona (za mobilni i desktop)
                const iconClass = finalTheme === 'dark' ? 'bi-sun-fill' : 'bi-moon-fill';
                const iconEls = [document.getElementById('themeToggleIcon'), document.getElementById('themeToggleIconDesktop')];
                iconEls.forEach(iconEl => {
                    if (iconEl) {
                        iconEl.classList.remove('bi-sun-fill', 'bi-moon-fill');
                        iconEl.classList.add(iconClass);
                    }
                });
                // Dodatni fiks za Canvas okruženje
                if (window.parent !== window) {
                    const parentTheme = window.parent.document.documentElement.getAttribute('data-bs-theme');
                    if (parentTheme === 'dark' && theme === 'system') {
                        htmlEl.setAttribute('data-bs-theme', 'dark');
                    }
                }
            }
            
            function toggleTheme() {
                const currentAppliedTheme = htmlEl.getAttribute('data-bs-theme');
                const newTheme = currentAppliedTheme === 'light' ? 'dark' : 'light';
                
                localStorage.setItem('theme', newTheme);
                applyLocalStorageTheme(newTheme);

                const event = new CustomEvent('themeChanged', { detail: { theme: newTheme } });
                window.dispatchEvent(event);
            }
            window.toggleTheme = toggleTheme;
            
            // Pomoćna funkcija za postavljanje inicijalnih ikona nakon što se DOM učita
            function initializeIcons() {
                // Postavljanje ikone sidebara
                const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                const toggleIcon = document.getElementById('sidebarToggleIcon');
                if (toggleIcon) {
                    // AŽURIRANE IKONE: Layout Sidebar Inset
                    toggleIcon.classList.add(isCollapsed ? 'bi-layout-sidebar-inset-reverse' : 'bi-layout-sidebar-inset');
                }
                // Ponovno postavljanje ikone teme sa novim DOM elementima
                const currentTheme = htmlEl.getAttribute('data-bs-theme');
                applyLocalStorageTheme(currentTheme);
            }
        </script>
    </head>
    <body>
        <script>
            // **********************************************
            // LOGIKA NAKON UČITAVANJA DOM-a (Samo inicijalizacija i slušači)
            // **********************************************
            document.addEventListener('DOMContentLoaded', () => {
                initializeIcons(); // Postavljanje ikona nakon što su elementi dostupni
                // --- Logika za Temu (Slušači) ---
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
                    if (localStorage.getItem('theme') === 'system') {
                        applyLocalStorageTheme('system');
                    }            
                });

                window.addEventListener('themeChanged', (e) => {
                    const theme = e.detail?.theme || localStorage.getItem('theme') || 'system';
                    applyLocalStorageTheme(theme);
                });
                
                // FIX: Ažurirana logika za zatvaranje Offcanvas menija
                document.querySelectorAll('#sidebarOffcanvas a[href]').forEach(link => {
                    link.addEventListener('click', () => {
                        const offcanvasElement = document.getElementById('sidebarOffcanvas');
                        
                        setTimeout(() => {
                            const offcanvas = bootstrap.Offcanvas.getInstance(offcanvasElement);
                            if (offcanvas) {
                                offcanvas.hide();
                            }
                        }, 50);
                    });
                });
            });

            document.addEventListener('DOMContentLoaded', () => {

                function updateLanguageLabel() {
                    const lang = I18N.getLanguage().toUpperCase();

                    document
                        .querySelectorAll('.currentLanguageLabel')
                        .forEach(label => {
                            label.textContent = lang;
                        });
                }
                // inicijalno stanje
                updateLanguageLabel();

                // klik u navbar dropdownu
                document.querySelectorAll('.js-lang-select').forEach(btn => {
                    btn.addEventListener('click', () => {
                        setLanguage(btn.dataset.lang);
                    });
                });

                // SVE promene jezika (settings, navbar, bilo gde)
                window.addEventListener('languageChanged', updateLanguageLabel);
            });

        </script>
        
