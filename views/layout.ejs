        <!-- GLOBAL CONFIRM MODAL -->
        <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-top mt-4">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmModalTitle">
                            Confirm Action
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body" id="confirmModalBody">
                        Are you sure you want to proceed?
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <a href="#"
                        class="btn btn-danger"
                        id="confirmModalConfirmBtn">
                            Delete
                        </a>
                    </div>

                    <div class="modal fade"
                        id="confirmModal"
                        tabindex="-1"
                        data-bs-backdrop="static"
                        data-bs-keyboard="false">                
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="/js/i18n.js"></script>
        <script>

            // =====================================================
            // GLOBAL CONFIRM MODAL HANDLER
            // =====================================================

            // Čuva referencu na callback koji treba da se izvrši
            // kada korisnik klikne na "Confirm" u modalu.
            // (npr. form.submit() ili redirect)
            let currentConfirmCallback = null;

            // Otvara globalni confirm modal
            // options:
            // - title: naslov modala
            // - message: HTML poruka (može sadržati <strong>)
            // - confirmUrl: fallback URL (ako nema callbacka)
            // - confirmClass: CSS klasa za Confirm dugme (npr. btn-danger)
            // - onConfirm: funkcija koja se izvršava klikom na Confirm
            function openConfirmModal(options) {

                const {
                    title = 'Confirm Action',
                    message = 'Are you sure?',
                    confirmUrl = null,
                    confirmClass = 'btn-danger',
                    onConfirm = null
                } = options;

                // Dohvat Bootstrap modal instance
                const modalEl = document.getElementById('confirmModal');
                const modal = new bootstrap.Modal(modalEl);

                // Postavljanje naslova i poruke
                document.getElementById('confirmModalTitle').textContent = title;
                document.getElementById('confirmModalBody').innerHTML = message;

                // Confirm dugme u modalu
                const confirmBtn = document.getElementById('confirmModalConfirmBtn');

                // Sačuvaj callback za kasnije (klik na Confirm)
                currentConfirmCallback = onConfirm;

                // Stil dugmeta (danger, warning, itd.)
                confirmBtn.className = `btn ${confirmClass}`;

                // Klik na Confirm dugme
                confirmBtn.onclick = (e) => {
                    e.preventDefault();

                    // Ako je prosleđen callback → izvrši ga
                    if (typeof currentConfirmCallback === 'function') {
                        currentConfirmCallback();

                    // Inače fallback na URL (npr. <a href="..."> delete)
                    } else if (confirmUrl) {
                        window.location.href = confirmUrl;
                    }

                    // Zatvori modal nakon potvrde
                    modal.hide();
                };

                // Prikaži modal
                modal.show();
            }

        </script>
    </body>
</html>