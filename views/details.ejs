<% const qs = queryString || null; %>

<% 
    // Funkcija za status badge-eve
    let statusClass = 'bg-success'; 
    let statusText = 'OK';
    if (component.quantity <= 0) {
        statusClass = 'bg-danger';
        statusText = 'OUT OF STOCK';
    } else if (component.quantity <= component.min_stock) {
        statusClass = 'bg-warning';
        statusText = 'LOW STOCK';
    }
%>

<% 
    // Dohvatanje poruke iz query parametara (message=...)
    const successMessage = req.query.message; 
%>

<% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>

        <span data-i18n="<%= successMessage %>">
            <%= successMessage %>
        </span>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
<% } %>

<header class="d-flex justify-content-between align-items-center mb-0">
    <div class="d-flex">    
        <h1 class="h3 text-body mb-0"
            data-i18n="details.title">
            Component Details
        </h1>
        <i class="bi bi-info-circle ms-2 text-muted"
           role="button"
           title="About Component Details"
           data-i18n-attr="title"
           data-i18n="details.help_title"
           onclick="togglePageHelp()"></i>
    </div>
    
</header>

<p class="card-text text-muted small mb-4"
   data-i18n="details.subtitle">
    Detailed view of a single component, including technical data, stock status, and related information.
</p>


<!-- Toggle info -->
<div id="pageHelp"
    class="card border-0 bg-body-tertiary my-2 d-none">
    <div class="card-body small text-body-secondary">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
            <div>
                <strong class="text-body"
                        data-i18n="details.help_header">
                    About Component Details
                </strong><br>
                <span data-i18n="details.help_p1">
                    This page displays all stored information for a selected component.
                </span>
                <br>
                <span data-i18n="details.help_p2">
                    It provides an overview of technical data, category, location, and current stock status, allowing you to review the component without modifying its data.
                </span>
                <br>
                <span data-i18n="details.help_p3">
                    Editing and stock adjustments are performed from the corresponding edit actions.
                </span>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center mb-2">
    <a href="/components/edit/<%= component.id %>?<%= queryString %>" class="btn btn-secondary me-1">
        <i class="bi bi-pencil me-0"></i>
        <span data-i18n="details.edit">Edit</span>
    </a>
    <button type="button" class="btn btn-danger me-1" data-bs-toggle="modal" data-bs-target="#deleteModal">
        <i class="bi bi-trash me-0"></i>
        <span data-i18n="details.delete">Delete</span>
    </button>
    
    <% if (queryString) { %>
        <a href="/components?<%= queryString %>" class="btn btn-outline-secondary">
    <% } else { %>
        <a href="/components" class="btn btn-outline-secondary">
    <% } %>
        <i class="bi bi-list me-0"></i>
        <span data-i18n="details.back">Back to List</span>
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="<%= component.image_url || '/images/default-component.png' %>" 
                     class="img-fluid rounded mb-3" 
                     alt="<%= component.name %>" 
                     style="max-height: 250px; object-fit: contain;">
                
                <h2 class="h1 fw-bold mb-1 <%= statusClass === 'bg-danger' ? 'text-danger' : (statusClass === 'bg-warning' ? 'text-warning' : 'text-success') %>">
                    <%= component.quantity %>
                </h2>
                <p class="text-muted mb-4"
                   data-i18n="details.units">
                    units in stock
                </p>
                
                <span class="badge rounded-pill p-2 fs-6 <%= statusClass %> text-white">
                    <%= statusText %>
                </span>
            </div>

            <div class="col-md-8 p-4">
                <h5 class="mb-4 pb-2 border-bottom"
                    data-i18n="details.inventory">
                    Inventory Data
                </h5>
                
                <dl class="row mb-0">
                    <dt class="col-sm-3" data-i18n="details.part_number">Part Number:</dt>
                    <dd class="col-sm-9"><%= component.part_number || 'N/A' %></dd>

                    <dt class="col-sm-3" data-i18n="details.name">Name:</dt>
                    <dd class="col-sm-9"><%= component.name || 'N/A' %></dd>

                    <dt class="col-sm-3" data-i18n="details.category">Category:</dt>
                    <dd class="col-sm-9"><%= component.category || 'Uncategorized' %></dd>
                    
                    <dt class="col-sm-3" data-i18n="details.location">Location:</dt>
                    <dd class="col-sm-9"><%= component.location || 'N/A' %></dd>

                    <dt class="col-sm-3" data-i18n="details.min_stock">Min. Stock:</dt>
                    <dd class="col-sm-9"><%= component.min_stock %></dd>
                </dl>
                
                <h5 class="mt-5 mb-3 pb-2 border-bottom"
                    data-i18n="details.documentation">
                    Documentation
                </h5>
                
                <% if (component.datasheet_url) { %>
                    <p class="mb-2">
                        <a href="<%= component.datasheet_url %>" target="_blank" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-file-earmark-pdf me-1"></i>
                            <span data-i18n="details.view_datasheet">View Datasheet</span>
                        </a>
                    </p>
                <% } else { %>
                    <p class="text-muted"
                       data-i18n="details.no_datasheet">
                        Datasheet URL not provided.
                    </p>
                <% } %>
                
                <% if (component.description) { %>
                    <h5 class="mt-5 mb-3 pb-2 border-bottom"
                        data-i18n="details.description">
                        Description / Specs
                    </h5>
                    <p class="text-break" style="white-space: pre-line"><%= component.description %></p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<% if (!component.image_url) { %>
    <p class="text-muted small mt-3"
       data-i18n="details.note_image">
        Note: To display the image, create the `public/images` folder and place the `default-component.png` image inside it.
    </p>
<% } %>
                        
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"
              id="deleteModalLabel"
              data-i18n="details.confirm_title">
              Confirm Deletion
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <span data-i18n="details.confirm_text">
            Are you sure you want to permanently delete component:
          </span>
          <strong><%= component.name %> (<%= component.part_number %>)</strong>?
          <br>
          <span data-i18n="details.confirm_warning">
            This action cannot be undone.
          </span>
        </div>
        <div class="modal-footer">
          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal"
                  data-i18n="details.cancel">
              Cancel
          </button>
          <a href="/components/delete/<%= component.id %><%= queryString ? '?' + queryString : '' %>" class="btn btn-danger">
              <span data-i18n="details.delete_component">Delete Component</span>
          </a>
        </div>
      </div>
    </div>
</div>

<script>
    function applyDetailsI18n() {
        I18N.apply(['layout','details']);
    }

    document.addEventListener('DOMContentLoaded', applyDetailsI18n);
    window.addEventListener('languageChanged', applyDetailsI18n);

    function togglePageHelp() {
        document.getElementById('pageHelp').classList.toggle('d-none');
    }
</script>
