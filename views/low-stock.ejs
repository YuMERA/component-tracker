<header class="d-flex justify-content-between align-items-center mb-0">
    
    <div class="d-flex">    
        <h1 class="h3 text-body mb-0"
            data-i18n="low_stock.title">Low Stock Alerts</h1>
        <i class="bi bi-info-circle ms-2 text-muted"
        role="button"
        data-i18n-attr="title:low_stock.help_title"
        title="About low stock alerts"
        onclick="togglePageHelp()"></i>
    </div>

    <a href="/low-stock/export" class="btn btn-success mb-0">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i>
        <span data-i18n="low_stock.export_csv">Export CSV</span>
    </a>
    
</header>

<p class="card-text text-muted small mb-3"
   data-i18n="low_stock.subtitle">
   View components that are running low on stock.
</p>

<!-- Toggle info kada se klikne na ikonu/button-->
<div id="pageHelp"
    class="card border-0 bg-body-tertiary my-2 d-none">
    <div class="card-body small text-body-secondary">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
            <div>
                <strong class="text-body"
                        data-i18n="low_stock.help_header">
                        About Low Stock Alert
                </strong><br>
                <span data-i18n="low_stock.help_p1">
                    Low Stock Alerts highlight components whose quantity has fallen below the defined minimum stock level.
                </span>
                <br>
                <span data-i18n="low_stock.help_p2">
                    This helps you notice parts that may soon run out, so you can restock them before they become unavailable during work.
                </span>
                <br>
                <span data-i18n="low_stock.help_p3">
                    Alerts are informational only — they do not block usage or trigger automatic actions.
                </span>
                <br>
                <span data-i18n="low_stock.help_p4">
                    Minimum stock values are defined per component and can be adjusted at any time.
                </span>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-warning border-0 shadow-sm" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    <span data-i18n="low_stock.warning">
        These components need immediate restocking attention.
    </span>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-secondary">
                    <tr>
                        <th style="width: 50px;"></th> 
                        <th scope="col" class="small text-uppercase" data-sort="text">
                            <span data-i18n="low_stock.col_name">Name</span><span class="sort-indicator"></span>
                        </th>
                        <th scope="col" class="small text-uppercase" data-sort="text">
                            <span data-i18n="low_stock.col_part_no">Part No.</span><span class="sort-indicator"></span>
                        </th>
                        <th scope="col" class="small text-uppercase" data-sort="text">
                            <span data-i18n="low_stock.col_category">Category</span><span class="sort-indicator"></span>
                        </th>
                        <th scope="col" class="small text-uppercase" data-sort="text">
                            <span data-i18n="low_stock.col_location">Location</span><span class="sort-indicator"></span>
                        </th>
                        <th scope="col" class="small text-uppercase text-center" data-sort="number">
                            <span data-i18n="low_stock.col_in_stock">In Stock</span><span class="sort-indicator"></span>
                        </th>
                        <th scope="col" class="small text-uppercase text-center" data-sort="number">
                            <span data-i18n="low_stock.col_min_stock">Min. Stock</span><span class="sort-indicator"></span>
                        </th>
                        <th scope="col" class="small text-uppercase text-end"
                            data-i18n="low_stock.col_actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (lowStockComponents.length === 0) { %>
                        <tr>
                            <td colspan="8" class="text-center p-4 text-success">
                                <i class="bi bi-check-circle me-2"></i>
                                <span data-i18n="low_stock.all_ok">
                                    All components are adequately stocked!
                                </span>
                            </td>
                        </tr>
                    <% } else { %>
                        <% lowStockComponents.forEach(component => { %>
                            <% const rowClass = component.quantity <= 0 ? 'table-danger' : 'table-warning'; %>
                            <tr class="<%= rowClass %>">
                                <td class="text-center p-2 align-middle">
                                    <% if (component.image_url && component.image_url.trim() !== '') { %>
                                        <a href="<%= component.image_url %>" target="_blank"
                                           data-i18n-attr="title:low_stock.show_image"
                                           title="Show big picture">
                                            <img src="<%= component.image_url %>"
                                                 style="width: 40px; height: 40px; object-fit: contain; border-radius: 4px; background-color: white; border: 1px solid #b8b8b8;">
                                        </a>
                                    <% } %>
                                </td>
                                <td class="align-middle">
                                    <a href="/components/details/<%= component.id %>"
                                       data-i18n-attr="title:low_stock.view_details"
                                       title="View Component Details"
                                       class="h6 mb-0 fw-bold text-decoration-none text-primary d-block">
                                        <%= component.name %>
                                    </a>
                                </td>
                                <td class="align-middle">
                                    <a href="/components/details/<%= component.id %>"
                                        data-i18n-attr="title:low_stock.view_details"
                                        title="View Component Details"
                                        class="fw-normal text-decoration-none text-body d-block">
                                        <%= component.part_number || 'N/A' %>
                                    </a>
                                </td>
                                <td class="align-middle">
                                    <a href="/components?category=<%= encodeURIComponent(component.category || 'Uncategorized') %>"
                                        data-i18n-attr="title:low_stock.view_category"
                                        title="View all items in category"
                                        class="fst-italic text-decoration-none text-body d-block">
                                        <%= component.category || 'Uncategorized' %>
                                    </a>
                                </td>
                                <td class="align-middle fst-italic text-decoration-none text-body">
                                    <%= component.location || 'N/A' %>
                                </td>
                                <td class="align-middle text-center fw-bold <%= component.quantity <= 0 ? 'text-danger' : 'text-muted' %>"><%= component.quantity %></td>
                                <td class="align-middle text-center text-primary"><%= component.min_stock %></td>
                                <td class="align-middle text-end">
                                    <a href="/components/edit/<%= component.id %>?<%= queryString %>&returnQuery=__LOW_STOCK__"
                                        class="btn btn-sm btn-warning text-dark me-1"
                                        title="Restock"
                                        data-i18n-attr="title"
                                        data-i18n="low_stock.restock">
                                         <i class="bi bi-box-seam me-1"></i>
                                         <span data-i18n="low_stock.restock">Restock</span>
                                     </a>
                                     <a href="/components/details/<%= component.id %>?<%= queryString %>"
                                        class="btn btn-sm btn-outline-info"
                                        title="Details"
                                        data-i18n-attr="title"
                                        data-i18n="low_stock.details">
                                         <i class="bi bi-eye"></i>
                                     </a>                                     
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PAGINATION + LIMIT SELECT -->
<div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-2">

    <!-- Select za limit po strani -->
    <form id="limitForm" method="GET" class="d-flex align-items-center ">
        <label for="limitSelect" class="me-2 mb-0 fst-italic"
               data-i18n="low_stock.show">Show:</label>
        <select id="limitSelect" name="limit" class="form-select form-select-sm fw-bold" style="width: auto;" onchange="this.form.submit()">
            <% [10, 20, 50, 100, 'All'].forEach(opt => { %>
                <option value="<%= opt %>" <%= (limit === opt || (limit === null && opt === 'All')) ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
        </select>
        <span class="ms-2 text-muted fst-italic">
            <span data-i18n="low_stock.items">of</span> <%= totalItems %> 
        </span>
    </form>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <nav class="mx-auto">
            <ul class="pagination mb-0 justify-content-center">
                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit || 'All' %>">«</a>
                </li>

                <% 
                    const maxVisible = 5;
                    let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                    let endPage = Math.min(totalPages, startPage + maxVisible - 1);
                    if (endPage - startPage + 1 < maxVisible) {
                        startPage = Math.max(1, endPage - maxVisible + 1);
                    }
                %>

                <% if (startPage > 1) { %>
                    <li class="page-item"><a class="page-link" href="?page=1&limit=<%= limit || 'All' %>">1</a></li>
                    <% if (startPage > 2) { %>
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    <% } %>
                <% } %>

                <% for (let p = startPage; p <= endPage; p++) { %>
                    <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= p %>&limit=<%= limit || 'All' %>"><%= p %></a>
                    </li>
                <% } %>

                <% if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %>
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    <% } %>
                    <li class="page-item"><a class="page-link" href="?page=<%= totalPages %>&limit=<%= limit || 'All' %>"><%= totalPages %></a></li>
                <% } %>

                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit || 'All' %>">»</a>
                </li>
            </ul>
        </nav>
    <% } %>
</div>

<script>

    //**********************************************************************************
    //** Akcija na promenu jezika za svaku stranu isto
        /*  layout se prevede pri load-u
            layout se prevede i kad klikneš SR / EN
            nema bljeska
            nema potrebe da stranice brinu o layoutu
        */
    //***********************************************************************************
    function applyLowStockI18n() {
        I18N.apply(['layout','low-stock']);
    }

    document.addEventListener('DOMContentLoaded', applyLowStockI18n);
    // layout mora da reaguje i na live promenu jezika
    window.addEventListener('languageChanged', applyLowStockI18n);
    //************************************************************************************

    function togglePageHelp() {
        document
            .getElementById('pageHelp')
            .classList.toggle('d-none');
    }
</script>

<!-- LOAD SORTING JS -->
<script src="/js/table-sort.js"></script>
