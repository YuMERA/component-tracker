<header class="d-flex justify-content-between align-items-center mb-0">
   
    <div class="d-flex">    
        <h1 class="h3 text-body mb-0" data-i18n="dashboard.title">Dashboard</h1>
        <i class="bi bi-info-circle ms-2 text-muted"
        role="button"
        title="About dashboard"
        data-i18n="dashboard.help.title"
        data-i18n-attr="title"
        onclick="togglePageHelp()"></i>
    </div>
</header>
<p class="card-text text-muted small mb-3" data-i18n="dashboard.subtitle">An overview of inventory status and key metrics.</p>

<!-- Toggle info kada se klikne na ikonu/button-->
<div id="pageHelp"
    class="card border-0 bg-body-tertiary my-2 d-none">
    <div class="card-body small text-body-secondary">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
            <div>
                <strong class="text-body" data-i18n="dashboard.help.heading">About Dashboard</strong><br>
                <span data-i18n="dashboard.help.text1">The dashboard provides a quick overview of the current state of the workshop inventory.</span><br>
                <span data-i18n="dashboard.help.text2">It highlights key information such as total components, categories, and items that require attention, helping 
                you understand what is available at a glance before starting work.</span><br>
                <span data-i18n="dashboard.help.text3">Detailed management and editing are done on the respective</span><br>
            </div>
        </div>
    </div>
</div>

<div class="row">
    
    <!-- KARTICA 1: UNIQUE COMPONENTS / TOTAL ITEMS -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/components" class="card border-start-primary shadow-sm h-100 py-2 text-decoration-none">
            <div class="card-body py-2">
                <div class="row no-gutters align-items-start">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1" data-i18n="dashboard.cards.unique_components">Unique Components</div>
                        <div class="h5 mb-0 fw-bold text-gray-800"><%= stats.totalComponents %></div>    
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-box-seam h2 text-primary opacity-75"></i>
                    </div>
                    <span class="text-xs text-muted mt-2 pt-2 border-top">
                        <span data-i18n="dashboard.cards.total_items">Total Items (pcs):</span> 
                        <span class="text-body"><%= stats.totalQuantity %></span>
                    </span>
                </div>
            </div>
        </a>
    </div>

    <!-- KARTICA 2: COMPONENT CATEGORIES -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/categories" class="card border-start-success shadow-sm h-100 py-2 text-decoration-none">
            <div class="card-body py-2">
                <div class="row no-gutters align-items-start">
                    <div class="col me-2">
                        <!-- VREDNOST SE DINAMIČKI UČITAVA: <%= stats.categories %> -->
                        <div class="text-xs fw-bold text-success text-uppercase mb-1" data-i18n="dashboard.cards.categories">Component Categories</div>
                        <div class="h5 mb-0 fw-bold text-gray-800"><%= stats.categories %></div>
                    </div>
                    <div class="col-auto">
                           <i class="bi bi-folder-fill h2 text-success opacity-75"></i>
                    </div>
                    <!-- Mali tekst, odvojen linijom -->
                    <span class="text-xs text-muted mt-2 pt-2 border-top" data-i18n="dashboard.cards.categories_desc">
                        Defined categories in the system. 
                    </span>
                </div>
            </div>
        </a>
    </div>

    <!-- KARTICA 3: LOW STOCK ALERTS -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/components?status=low-stock" class="card border-start-warning shadow-sm h-100 py-2 text-decoration-none">
            <div class="card-body py-2">
                <div class="row no-gutters align-items-start">
                    <div class="col me-2">
                        <!-- VREDNOST SE DINAMIČKI UČITAVA: <%= stats.lowStock %> -->
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1" data-i18n="dashboard.cards.low_stock">Low Stock Alerts</div>
                        <div class="h5 mb-0 fw-bold text-gray-800"><%= stats.lowStock %></div>
                    </div>
                    <div class="col-auto">
                           <i class="bi bi-exclamation-triangle-fill h2 text-warning opacity-75"></i>
                    </div>
                    <!-- Mali tekst, odvojen linijom -->
                    <span class="text-xs text-muted mt-2 pt-2 border-top" data-i18n="dashboard.cards.low_stock_desc">
                        Components below the minimum. 
                    </span>
                </div>
            </div>
        </a>
    </div>

    <!-- KARTICA 4: OUT OF STOCK -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/components?status=out-of-stock" class="card border-start-danger shadow-sm h-100 py-2 text-decoration-none">
            <div class="card-body py-2">
                <div class="row no-gutters align-items-start">
                    <div class="col me-2">
                        <!-- VREDNOST SE DINAMIČKI UČITAVA: <%= stats.outOfStock %> -->
                        <div class="text-xs fw-bold text-danger text-uppercase mb-1" data-i18n="dashboard.cards.out_of_stock">Out of Stock</div>
                        <div class="h5 mb-0 fw-bold text-gray-800"><%= stats.outOfStock %></div>
                    </div>
                    <div class="col-auto">
                           <i class="bi bi-x-octagon-fill h2 text-danger opacity-75"></i>
                    </div>
                    <!-- Mali tekst, odvojen linijom -->
                    <span class="text-xs text-muted mt-2 pt-2 border-top" data-i18n="dashboard.cards.out_of_stock_desc">
                        Components with quantity 0. 
                    </span>
                </div>
            </div>
        </a>
    </div>

</div>

<div class="row">
    
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-2 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <h6 class="m-0 fw-bold" data-i18n="dashboard.recent.title">Recent Components Added</h6>
                    <span class="text-muted" data-i18n="dashboard.recent.subtitle">The last five components</span>
                </div>
                <a href="/components" class="btn btn-sm btn-outline-primary" data-i18n="dashboard.recent.view_all">View All Components</a>
            </div>
            <div class="card-body">
                <% if (recentComponents.length === 0) { %>
                    <p class="text-muted text-center py-3" data-i18n="dashboard.recent.empty">No recent additions.</p>
                <% } else { %>
                    <ul class="list-group list-group-flush">
                        <% recentComponents.forEach(component => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>                                                                    
                                    <a href="/components/details/<%= component.id %>" class="text-decoration-none fw-bold">
                                        <% if (component.image_url && component.image_url.trim() !== '') { %>                                        
                                            <img src="<%= component.image_url %>"
                                                    style="width: 30px; height: 30px; object-fit: contain; border-radius: 4px; background-color: white; padding: 2px;">
                                        <% } %>   
                                        <%= component.name %>
                                    </a><br>
                                    <span class="d-block text-normal fw-normal"><%= component.part_number || 'N/A' %></span>   
                                    <span class="d-block text-secondary fst-italic">
                                        <span data-i18n="dashboard.recent.added">Added:</span> <%= component.formatted_created_at ? component.formatted_created_at : '—' %>
                                    </span>
                                </div>
                                <span class="badge bg-secondary rounded-pill"><%= component.quantity %> pcs</span>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-2 d-flex flex-row align-items-center justify-content-between bg-warning">
                <div>
                    <h6 class="m-0 fw-bold" data-i18n="dashboard.lowstock.title">Critical Low Stock Alerts</h6>
                    <span class="text-muted" data-i18n="dashboard.lowstock.subtitle">The last five components</span>
                </div>
                <a href="/components?status=low-stock" class="btn btn-sm btn-outline-primary" data-i18n="dashboard.lowstock.view_all">View All Alerts</a>
            </div>
            <div class="card-body">
                <% if (criticalLowStock.length === 0) { %>
                    <p class="text-success text-center py-3">
                        <i class="bi bi-check-circle me-1"></i>
                         <span data-i18n="dashboard.lowstock.ok">All minimum stock levels are met.</span>
                    </p>
                <% } else { %>
                    <ul class="list-group list-group-flush">
                        <% criticalLowStock.forEach(component => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-warning">
                                <div>
                                    <a href="/components/details/<%= component.id %>" class="text-decoration-none fw-bold">
                                        <% if (component.image_url && component.image_url.trim() !== '') { %>                                        
                                            <img src="<%= component.image_url %>"
                                                    style="width: 30px; height: 30px; object-fit: contain; border-radius: 4px; background-color: white; padding: 2px;">
                                        <% } %>   
                                        <%= component.name %>
                                    </a><br>
                                    <span class="d-block text-primary"><%= component.part_number || 'N/A' %></span>
                                    <span class="d-block text-muted"><span data-i18n="dashboard.lowstock.needed">Needed: </span><%= component.min_stock %> pcs</span>
                                </div>
                                <span class="badge bg-danger rounded-pill" data-i18n="dashboard.lowstock.in_stock"><%= component.quantity %> in stock</span>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    //**********************************************************************************
    //** Akcija na promenu jezika za svaku stranu isto
        /*  layout se prevede pri load-u
            layout se prevede i kad klikneš SR / EN
            nema bljeska
            nema potrebe da stranice brinu o layoutu
        */
    //***********************************************************************************
    function applyDashboardI18n() {
        I18N.apply(['layout','dashboard']);
    }

    document.addEventListener('DOMContentLoaded', applyDashboardI18n);
    // layout mora da reaguje i na live promenu jezika
    window.addEventListener('languageChanged', applyDashboardI18n);
    //************************************************************************************

    function togglePageHelp() {
    document
        .getElementById('pageHelp')
        .classList.toggle('d-none');
    }
</script>