<% if (locals.message) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <%= locals.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
<% if (locals.error) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <%= locals.error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header fw-bold">Add New Category</div>
            <div class="card-body">
                <form action="/admin/categories/add" method="POST">
                    <div class="mb-3">
                        <label for="new_category_name" class="form-label">Category Name</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="new_category_name" name="name" required>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i> Add
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-body fw-bold">Existing Categories (<%= categories.length %>)</div>
            <div class="card-body p-0">
                <% if (categories.length === 0) { %>
                    <p class="text-muted text-center py-4">No categories defined yet.</p>
                <% } else { %>
                    <ul class="list-group list-group-flush">
                        <% categories.forEach(category => { %>
                            <li class="list-group-item bg-body text-body d-flex justify-content-between align-items-center">
                                
                                <span id="name-<%= category.id %>" class="category-display"><%= category.name %></span>
                                
                                <form id="edit-form-<%= category.id %>" action="/admin/categories/edit/<%= category.id %>" method="POST" class="d-none w-50">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" name="name" value="<%= category.name %>" required>
                                        <button type="submit" class="btn btn-success">Save</button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="toggleEdit('<%= category.id %>')">Cancel</button>
                                    </div>
                                </form>


                                <div class="btn-group btn-group-sm" id="actions-<%= category.id %>">
                                    <button class="btn btn-outline-secondary" onclick="toggleEdit('<%= category.id %>')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    
                                    <a href="/admin/categories/delete/<%= category.id %>" 
                                       class="btn btn-outline-danger" 
                                       onclick="return confirm('Are you sure you want to delete the category: <%= category.name %>? WARNING: Components using this category will be marked as undefined.')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    // Funkcija za prebacivanje između prikaza i forme za edit
    function toggleEdit(id) {
        const display = document.getElementById(`name-${id}`);
        const editForm = document.getElementById(`edit-form-${id}`);
        const actions = document.getElementById(`actions-${id}`);

        if (editForm.classList.contains('d-none')) {
            // Prebaci na Edit mod
            display.classList.add('d-none');
            editForm.classList.remove('d-none');
            actions.classList.add('d-none');
        } else {
            // Prebaci na Prikaz
            display.classList.remove('d-none');
            editForm.classList.add('d-none');
            actions.classList.remove('d-none');
        }
    }
</script>